{
  "name": "task-checklist",
  "version": "5.3",
  "description": "A Warframe Task Checklist to track daily, weekly, and other tasks. Built with HTML, CSS, and vanilla JavaScript, processed with Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-release": "vite build --mode release",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui --open=false --coverage",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint --concurrency=auto --cache",
    "lint:css": "stylelint \"sources/**/*.css\" --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warframe-tools/Task-Checklist.git"
  },
  "keywords": [
    "warframe",
    "task",
    "checklist",
    "gaming",
    "utility"
  ],
  "author": "WarframeTools",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/warframe-tools/Task-Checklist/issues"
  },
  "homepage": "https://warframetools.com/Task-Checklist/",
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "sanitize.css": "^13.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5"
  }
}
